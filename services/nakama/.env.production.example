# Copy to a deployment secret store or a non-committed environment file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
NAKAMA_CONSOLE_USERNAME=replace-with-admin-username
NAKAMA_CONSOLE_PASSWORD=replace-with-a-long-random-password
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-a-64-character-random-secret
NAKAMA_RUNTIME_HTTP_KEY=replace-with-a-64-character-random-secret
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-a-64-character-random-secret
NAKAMA_REFRESH_ENCRYPTION_KEY=replace-with-a-64-character-random-secret
NAKAMA_SERVER_KEY=replace-with-a-random-server-key
MATCH_PRICE_INGEST_SECRET=replace-with-a-random-ingest-secret
MATCH_PRICE_ALERT_WEBHOOK_URL=
MATCH_PRICE_ALLOW_BOOTSTRAP=false
MATCH_PRICE_ALLOWED_SYMBOLS=BTC/USDT
MATCH_PRICE_ALLOWED_SOURCE_PREFIXES=binance:
MATCH_PRICE_MAX_LATEST_AGE_SECONDS=300
MATCH_PRICE_MAX_FUTURE_SKEW_SECONDS=120
MATCH_PRICE_MAX_MOVE_BPS=2500
MATCH_PRICE_REQUIRE_SIGNATURE=true
MATCH_PRICE_SIGNATURE_MAX_SKEW_SECONDS=60
FINANCE_METRICS_ADMIN_USER_IDS=comma-separated-nakama-user-uuid-list
ALLOW_CLIENT_PORTFOLIO_SCORE_SUBMISSION=false
ALLOW_DIRECT_FINANCE_MATCH_CREATION=false
